    sh:sparql [ sh:select """SELECT $this WHERE {
  $this <urn:qualification:revision:iri> ?iri .
  $this <urn:qualification:revision:cracking> ?cracking .
  $this <urn:qualification:revision:faulting> ?faulting .
  $this <urn:qualification:revision:surface_type> ?surface_type .
  FILTER(!((?surface_type = 3) && (?iri > 0 && ?cracking >= 0 && ?cracking <= 100 && ?faulting >= 0)))
}""" ] .

