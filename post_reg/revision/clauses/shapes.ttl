@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <urn:qualification:revision:> .

ex:aashto_r85-map-narrow-shape a sh:NodeShape ;
    sh:targetClass ex:aashto_r85-map-narrow ;
    sh:property [ sh:path ex:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ; sh:hasValue "percent" ] ;
    sh:property [ sh:path ex:value ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:sparql [ sh:select """SELECT $this WHERE {
  $this <urn:qualification:revision:value> ?value .
  FILTER(!(?value >= 33))
}""" ] .

