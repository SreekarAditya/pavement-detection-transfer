ex:hif18022-table8-01-shape a sh:NodeShape ;
    sh:targetClass ex:hif18022-table8-01 ;
    sh:property [ sh:path ex:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ; sh:hasValue "in/mi,percent,in" ] ;
    sh:property [ sh:path ex:iri ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path ex:cracking ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path ex:rutting ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path ex:surface_type ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path ex:iri_unit ; sh:maxCount 1 ; sh:nodeKind sh:Literal ; sh:hasValue "in/mi" ] ;
    sh:property [ sh:path ex:cracking_unit ; sh:maxCount 1 ; sh:nodeKind sh:Literal ; sh:hasValue "percent" ] ;
    sh:property [ sh:path ex:rutting_unit ; sh:maxCount 1 ; sh:nodeKind sh:Literal ; sh:hasValue "in" ] ;
    sh:sparql [ sh:select """SELECT $this WHERE {
  $this <urn:qualification:revision:iri> ?iri .
  $this <urn:qualification:revision:cracking> ?cracking .
  $this <urn:qualification:revision:rutting> ?rutting .
  $this <urn:qualification:revision:surface_type> ?surface_type .
  FILTER(!((?surface_type = 2) && ((FLOOR(?iri * 1 + 0.5) / 1 < 95) && (FLOOR(?cracking * 1 + 0.5) / 1 < 5) && (FLOOR(?rutting * 100 + 0.5) / 100 < 0.20))))
}""" ] .

